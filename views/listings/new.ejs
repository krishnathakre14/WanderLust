<% layout("/layouts/boilerplate") %>

<div class="row mt-3 justify-content-center">
    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">

        <h3 class="mb-4 text-center text-md-start">Create a New Listing</h3>

        <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Title</label>
                <input
                    id="title"
                    name="listing[title]"
                    type="text"
                    class="form-control"
                    placeholder="Add a catchy title"
                    required
                >
                <div class="valid-feedback">
                    Title looks good!
                </div>
                <div class="invalid-feedback">
                    Please enter a title.
                </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label fw-semibold">Description</label>
                <textarea
                    id="description"
                    name="listing[description]"
                    class="form-control"
                    placeholder="Enter description"
                    rows="4"
                    required
                ></textarea>
                <div class="invalid-feedback">
                    Please enter a short description.
                </div>
            </div>

            <!-- Image Upload -->
            <div class="mb-3">
                <label for="image" class="form-label fw-semibold">Upload Listing Image</label>
                <input
                    id="image"
                    name="listing[image]"
                    type="file"
                    class="form-control"
                    required
                >
                <div class="invalid-feedback">
                    Please choose an image file.
                </div>
            </div>

            <!-- Price and Country in a Responsive Row -->
            <div class="row">
                <div class="mb-3 col-12 col-md-4">
                    <label for="price" class="form-label fw-semibold">Price (&#8377;)</label>
                    <input
                        id="price"
                        name="listing[price]"
                        type="number"
                        min="0"
                        class="form-control"
                        placeholder="1200"
                        required
                    >
                    <div class="invalid-feedback">
                        Price should be valid.
                    </div>
                </div>

                <div class="mb-3 col-12 col-md-8">
                    <label for="country" class="form-label fw-semibold">Country</label>
                    <input
                        id="country"
                        name="listing[country]"
                        type="text"
                        class="form-control"
                        placeholder="India"
                        required
                    >
                    <div class="invalid-feedback">
                        Country name should be valid.
                    </div>
                </div>
            </div>

            <!-- Location -->
            <div class="mb-4">
                <label for="location" class="form-label fw-semibold">Location</label>
                <input
                    id="location"
                    name="listing[location]"
                    type="text"
                    class="form-control"
                    placeholder="Jaipur, Rajasthan"
                    required
                >
                <div class="invalid-feedback">
                    Location should be valid.
                </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid d-md-block mb-4">
                <button class="btn btn-dark add-btn px-4 py-2">
                    Add Listing
                </button>
            </div>

        </form>
    </div>
</div>