
<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-8 offset-2">
        <br>

        <h3 class="mb-4">Create a New Listing</h3>

        <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label">Title</label>

                <input
                    name="listing[title]"
                    type="text"
                    class="form-control"
                    placeholder="Add a catchy title"
                    required
                >

                <div class="valid-feedback">
                    Title looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter a title.
                </div>
            </div>


            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description</label>

                <textarea
                    name="listing[description]"
                    class="form-control"
                    placeholder="Enter description"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please enter a short description.
                </div>
            </div>


            <!-- Image -->
             

<div class="mb-3">
    <label class="form-label">Upload Listing Image </label>

    <input
        name="listing[image]"
        type="file"
        class="form-control"
        placeholder="Enter image URL/Link"
        required
    >
</div>


            <!-- Price -->
            <div class="mb-3">
                <label class="form-label">Price</label>

                <input
                    name="listing[price]"
                    
                    class="form-control"
                    placeholder="1200"
                    required
                >

                <div class="invalid-feedback">
                    Price should be valid.
                </div>
            </div>


            <!-- Country -->
            <div class="mb-3">
                <label class="form-label">Country</label>

                <input
                    name="listing[country]"
                    type="text"
                    class="form-control"
                    placeholder="India"
                    required
                >

                <div class="invalid-feedback">
                    Country name should be valid.
                </div>
            </div>


            <!-- Location -->
            <div class="mb-3">
                <label class="form-label">Location</label>

                <input
                    name="listing[location]"
                    type="text"
                    class="form-control"
                    placeholder="Jaipur, Rajasthan"
                    required
                >

                <div class="invalid-feedback">
                    Location should be valid.
                </div>
            </div>


            <!-- Submit Button -->
            <button class="btn btn-dark add-btn">
                Add
            </button>

            <br><br>

        </form>
    </div>
</div>

