<% layout("/layouts/boilerplate") %>

<div class="row mt-3 justify-content-center">
    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">

        <h3 class="mb-4 text-center text-md-start">Edit Your Listing</h3>

        <form
            method="post"
            action="/listings/<%= listing._id %>?_method=PUT"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
        >
            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Title</label>
                <input
                    id="title"
                    name="listing[title]"
                    type="text"
                    value="<%= listing.title %>"
                    class="form-control"
                    required
                >
                <div class="invalid-feedback">
                    Please enter a title.
                </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label fw-semibold">Description</label>
                <textarea
                    id="description"
                    name="listing[description]"
                    class="form-control"
                    rows="4"
                    required
                ><%= listing.description %></textarea>
                <div class="invalid-feedback">
                    Please enter a short description.
                </div>
            </div>

            <!-- Original Image Preview -->
            <div class="mb-3">
                <label class="form-label fw-semibold d-block">Original Listing Image</label>
                <div class="card p-2 bg-light border-0 shadow-sm d-inline-block">
                    <img 
                        src="<%= listing.image.url %>" 
                        alt="Original Listing Image" 
                        class="img-fluid rounded" 
                        style="max-height: 200px; object-fit: cover;"
                    >
                </div>
            </div>

            <!-- Upload New Image -->
            <div class="mb-3">
                <label for="image" class="form-label fw-semibold">Upload New Image</label>
                <input
                    id="image"
                    name="listing[image]"
                    type="file"
                    class="form-control"
                >
            </div>

            <!-- Price and Country in a Responsive Row -->
            <div class="row">
                <div class="mb-3 col-12 col-md-4">
                    <label for="price" class="form-label fw-semibold">Price (&#8377;)</label>
                    <input
                        id="price"
                        name="listing[price]"
                        type="number"
                        min="0"
                        value="<%= listing.price %>"
                        class="form-control"
                        required
                    >
                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>

                <div class="mb-3 col-12 col-md-8">
                    <label for="country" class="form-label fw-semibold">Country</label>
                    <input
                        id="country"
                        name="listing[country]"
                        type="text"
                        value="<%= listing.country %>"
                        class="form-control"
                        required
                    >
                    <div class="invalid-feedback">
                        Country name should be valid.
                    </div>
                </div>
            </div>

            <!-- Location -->
            <div class="mb-4">
                <label for="location" class="form-label fw-semibold">Location</label>
                <input
                    id="location"
                    name="listing[location]"
                    type="text"
                    value="<%= listing.location %>"
                    class="form-control"
                    required
                >
                <div class="invalid-feedback">
                    Location should be valid.
                </div>
            </div>
            
            <!-- Category -->
            <div class="mb-4">
                <label for="category" class="form-label fw-semibold">
                    Property Category
                </label>

                <select
                    id="category"
                    name="listing[category]"
                    class="form-select"
                    required
                >
                    <option value="Trending"
                        <%= (listing.category || "Trending") === "Trending" ? "selected" : "" %>>
                        Trending
                    </option>
                    <option value="Rooms"
                        <%= listing.category === "Rooms" ? "selected" : "" %>>
                        Rooms
                    </option>
                    <option value="Iconic Cities"
                        <%= listing.category === "Iconic Cities" ? "selected" : "" %>>
                        Iconic Cities
                    </option>
                    <option value="Mountains"
                        <%= listing.category === "Mountains" ? "selected" : "" %>>
                        Mountains
                    </option>
                    <option value="Castles"
                        <%= listing.category === "Castles" ? "selected" : "" %>>
                        Castles
                    </option>
                    <option value="Amazing pools"
                        <%= listing.category === "Amazing pools" ? "selected" : "" %>>
                        Amazing pools
                    </option>
                    <option value="Camping"
                        <%= listing.category === "Camping" ? "selected" : "" %>>
                        Camping
                    </option>
                    <option value="Farms"
                        <%= listing.category === "Farms" ? "selected" : "" %>>
                        Farms
                    </option>
                    <option value="Arctic"
                        <%= listing.category === "Arctic" ? "selected" : "" %>>
                        Arctic
                    </option>
                    <option value="Domes"
                        <%= listing.category === "Domes" ? "selected" : "" %>>
                        Domes
                    </option>
                    <option value="Boats"
                        <%= listing.category === "Boats" ? "selected" : "" %>>
                        Boats
                    </option>
                </select>

                <div class="invalid-feedback">
                    Please select a property category.
                </div>
            </div>


            <!-- Submit Button -->
            <div class="d-grid d-md-block mb-4">
                <button class="btn btn-dark edit-btn px-4 py-2">
                    Save Changes
                </button>
            </div>

        </form>
    </div>
</div>