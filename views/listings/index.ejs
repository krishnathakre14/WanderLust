
<% layout("/layouts/boilerplate") %>

<style>
    /* Category Filters */
    #filters {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        overflow-x: auto;
        white-space: nowrap;
        padding: 0.5rem 0 0.75rem;
        scrollbar-width: none;
        width: 100%;
        box-sizing: border-box;
    }

    #filters::-webkit-scrollbar {
        display: none;
    }

    #filters .filter {
        display: block;
        flex: 0 0 auto;
        min-width: 75px;
        margin: 0 0.5rem;
        padding: 0.6rem 0.25rem;
        text-align: center;
        text-decoration: none;
        color: #222;
        opacity: 0.7;
        border-bottom: 2px solid transparent;
        transition: opacity 0.2s ease, border-color 0.2s ease;
    }

    #filters .filter:hover {
        opacity: 1;
        color: #fe424d;
    }

    #filters .filter.active {
        opacity: 1;
        border-bottom-color: #fe424d;
    }

    #filters .filter i {
        display: block;
        font-size: 1.25rem;
        margin-bottom: 0.35rem;
    }

    #filters .filter p {
        margin: 0;
        font-size: 0.78rem;
    }

    
/* Tax Toggle */
.tax-toggle {
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 12px 16px;
    margin: 8px 0 16px auto;
    background: #fff;
    max-width: 100%;
}

.tax-toggle .form-check {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 0;
    min-height: auto;
}

.tax-toggle .form-check-input {
    float: none;
    flex-shrink: 0;
    margin: 0;
    cursor: pointer;
}

.tax-toggle .form-check-label {
    font-size: 14px;
    white-space: nowrap;
    cursor: pointer;
}

.tax-info {
    display: none;
}

@media (max-width: 576px) {
    .tax-toggle {
        margin: 8px 0 16px auto;
        padding: 10px 12px;
    }

    .tax-toggle .form-check-label {
        font-size: 12px;
    }
}


    /* Tax Information */
    .tax-info {
        display: none;
    }

    /* Listing Cards */
    .listing-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .listing-card:hover {
        transform: translateY(-4px);
    }

    .listing-link {
        text-decoration: none;
        color: inherit;
    }

    .card-img-top {
        height: 18rem;
        object-fit: cover;
    }

    /* Responsive Layout */
    @media (max-width: 768px) {
        .tax-toggle {
            margin: 0.5rem 0 1rem;
            width: 100%;
            justify-content: center;
        }
    }

    @media (max-width: 576px) {
        .listing-card:hover {
            transform: none;
        }
    }
</style>

<!-- Category Filters: Horizontal Scrolling Row -->
<div id="filters" class="my-2">

    <a href="/listings?category=Trending"
       class="filter <%= selectedCategory === 'Trending' ? 'active' : '' %>">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Rooms"
       class="filter <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </a>

    <a href="/listings?category=Iconic%20Cities"
       class="filter <%= selectedCategory === 'Iconic Cities' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=Mountains"
       class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </a>

    <a href="/listings?category=Castles"
       class="filter <%= selectedCategory === 'Castles' ? 'active' : '' %>">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
    </a>

    <a href="/listings?category=Amazing%20pools"
       class="filter <%= selectedCategory === 'Amazing pools' ? 'active' : '' %>">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing pools</p>
    </a>

    <a href="/listings?category=Camping"
       class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
        <i class="fa-solid fa-tent"></i>
        <p>Camping</p>
    </a>

    <a href="/listings?category=Farms"
       class="filter <%= selectedCategory === 'Farms' ? 'active' : '' %>">
        <i class="fa-solid fa-cow"></i>
        <p>Farms</p>
    </a>

    <a href="/listings?category=Arctic"
       class="filter <%= selectedCategory === 'Arctic' ? 'active' : '' %>">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
    </a>

    <a href="/listings?category=Domes"
       class="filter <%= selectedCategory === 'Domes' ? 'active' : '' %>">
        <i class="fa-solid fa-igloo"></i>
        <p>Domes</p>
    </a>

    <a href="/listings?category=Boats"
       class="filter <%= selectedCategory === 'Boats' ? 'active' : '' %>">
        <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
    </a>

    <a href="/listings"
       class="filter <%= !selectedCategory ? 'active' : '' %>">
        <i class="fa-solid fa-list"></i>
        <p>All Listings</p>
    </a>

</div>


<!-- Tax Toggle -->
<div class="d-flex justify-content-end">
    <div class="tax-toggle">
        <div class="form-check form-switch mb-0">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="switchCheckDefault"
            >
            <label
                class="form-check-label fw-semibold"
                for="switchCheckDefault"
            >
                Display total after taxes
            </label>
        </div>
    </div>
</div>

<!-- Responsive Listings Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-1">

    <% if (allListings.length === 0) { %>
        <div class="col-12 text-center py-5">
            <h4>No listings found</h4>
            <p class="text-secondary">
                Try another search or choose a different category.
            </p>
            <a href="/listings" class="btn btn-outline-dark">
                View all listings
            </a>
        </div>
    <% } %>

    <% for (let listing of allListings) { %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card listing-card h-100">

                    <div class="position-relative">
                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="<%= listing.title %>"
                            style="height: 18rem; object-fit: cover;"
                        >
                        <div class="card-img-overlay"></div>
                    </div>

                    <div class="card-body mt-2">
                        <p class="card-text mb-0">
                            <b><%= listing.title %></b>
                            <br>
                            &#8377;
                            <%= listing.price
                                ? listing.price.toLocaleString("en-IN")
                                : "N/A" %>
                            / night
                            <i class="tax-info text-secondary">
                                &nbsp;&nbsp;+18% GST
                            </i>
                        </p>
                    </div>

                </div>
            </a>
        </div>
    <% } %>

</div>

<script>
    // Display or hide GST information
    const taxSwitch = document.getElementById("switchCheckDefault");

    if (taxSwitch) {
        taxSwitch.addEventListener("change", () => {
            const taxInfo = document.getElementsByClassName("tax-info");

            for (const info of taxInfo) {
                info.style.display = taxSwitch.checked ? "inline" : "none";
            }
        });
    }
</script>
