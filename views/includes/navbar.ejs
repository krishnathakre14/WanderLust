<style>
    .search-btn {
        background-color: #fe424d !important;
        color: white !important;
        border: 1px solid #fe424d !important;
        border-radius: 25px !important;
        padding: 0.5rem 1rem !important;
        white-space: nowrap;
        transition: background-color 0.2s ease;
    }

    .search-btn:hover {
        background-color: #e0323c !important;
        border-color: #e0323c !important;
    }

    .search-btn i {
        display: inline;
        margin-right: 0.4rem;
    }

    .search-inp {
        border-radius: 25px !important;
        padding: 0.5rem 1.25rem !important;
        font-size: 0.95rem;
        min-width: 200px;
    }

    /* Mobile adjustments */
    @media (max-width: 767px) {
        .navbar-nav {
            width: 100%;
        }

        .navbar-nav .nav-link {
            padding: 0.5rem 0;
        }

        .search-container {
            width: 100%;
            margin: 0.75rem 0;
        }

        .search-inp {
            width: 100%;
            min-width: 0;
        }
    }
</style>

<nav class="navbar navbar-expand-md bg-light border-bottom sticky-top">
    <div class="container-fluid px-3 px-md-4">

        <!-- Brand Icon -->
        <a class="navbar-brand me-3" href="/listings">
            <i class="fa-regular fa-compass"></i>
        </a>

        <!-- Mobile Toggler -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

            <!-- Left Navigation -->
            <div class="navbar-nav me-auto">
                <a class="nav-link" href="/listings">Explore</a>
            </div>

            <!-- Center Search Bar -->
            <div class="search-container my-2 my-md-0 mx-md-auto">
                <form class="d-flex" role="search" action="/listings">
                    <input
                        class="form-control me-2 search-inp"
                        type="search"
                        name="q"
                        placeholder="Search destination"
                    />
                    <button class="btn search-btn" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>Search
                    </button>
                </form>
            </div>

            <!-- Right Navigation Links -->
            <div class="navbar-nav ms-auto align-items-md-center">
                <a class="nav-link me-md-2" href="/listings/new">
                    Airbnb your home
                </a>

                <% if (!currUser) { %>
                    <a class="nav-link fw-bold" href="/signup">Sign up</a>
                    <a class="nav-link fw-bold" href="/login">Log in</a>
                <% } %>

                <% if (currUser) { %>
                    <a class="nav-link fw-bold text-danger" href="/logout">Log out</a>
                <% } %>
            </div>

        </div>

    </div>
</nav>